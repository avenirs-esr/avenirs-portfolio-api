<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd
        http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="iamgreendev" id="add-assessment-modification-and-consultation-to-declared-activity">
        <addColumn tableName="declared_activity">
            <column name="assessment_modified_at" type="timestamp(6)"/>
            <column name="assessment_consulted_at" type="timestamp(6)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="declared_activity" columnName="assessment_modified_at"/>
            <dropColumn tableName="declared_activity" columnName="assessment_consulted_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
